# Copy this file to .env and paste your own keys after the = signs.
# Never share .env, never commit it, and never paste a key into a chat or a shared doc.

# Required: your Anthropic API key (console.anthropic.com)
ANTHROPIC_API_KEY=

# Optional: Google sign-in key for "Connect Gmail" (see the README, "Connect Gmail")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
